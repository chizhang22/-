# Copy this file to .env and fill locally. Never place credentials in VITE_* variables.
ZBX_API_PROTOCOL=openai
ZBX_BASE_URL=https://llmapi.paratera.com
ZBX_API_KEY=fill-your-key-locally
ZBX_MODEL=GLM-5.3
# Anthropic-compatible services can instead use ZBX_API_PROTOCOL=anthropic.
# The legacy ANTHROPIC_BASE_URL/ANTHROPIC_AUTH_TOKEN variables remain supported.
